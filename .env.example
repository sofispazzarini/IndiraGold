# Copiar a .env y completar. Los valores de este archivo son los defaults que usa la app
# si la variable no está definida (salvo los marcados como "obligatorio en producción").

# --- Django ---
# Obligatorio en producción: una clave larga y secreta (el default es solo para desarrollo).
SECRET_KEY=
# En producción: DEBUG=False (con True se muestran errores con datos internos).
# Si la variable no está, DEBUG queda en False. Para desarrollo local: DEBUG=True.
DEBUG=True
# Dominios separados por coma. Con DEBUG=True se agregan localhost, 127.0.0.1 y ngrok.
ALLOWED_HOSTS=
# Orígenes con esquema, separados por coma (ej. https://indiragold.com.ar).
CSRF_TRUSTED_ORIGINS=
# URL pública del sitio, se usa para las URLs de retorno de Mercado Pago.
SITE_URL=http://127.0.0.1:8000

# --- Base de datos (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=indiragold_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Mail (Gmail con contraseña de aplicación) ---
# Si EMAIL_HOST_USER o EMAIL_HOST_PASSWORD están vacíos, los mails se imprimen en la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente de los mails; si está vacío se usa EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
# Opcional: forzar un backend de mail (por defecto se elige según las credenciales).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Archivos ---
# Tamaño máximo de la foto de perfil de los clientes, en MB (por defecto 5).
FOTO_PERFIL_MAX_MB=5

# --- Mercado Pago ---
# Sin token la app funciona, pero el pago con Mercado Pago muestra un error.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_QR_IMAGE_URL=
MERCADO_PAGO_QR_EXTERNAL_POS_ID=

# --- WhatsApp de la tienda (solo dígitos, formato internacional) ---
COMPROBANTE_WHATSAPP=5492216375660

# --- Correo Argentino (cotización y envíos). Vacíos = Correo Argentino no configurado ---
CORREO_ARGENTINO_API_BASE_URL=
CORREO_ARGENTINO_API_TOKEN=
CORREO_ARGENTINO_API_USER=
CORREO_ARGENTINO_API_PASSWORD=
CORREO_ARGENTINO_AUTH_ENDPOINT=
CORREO_ARGENTINO_COTIZAR_ENDPOINT=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_POSTAL_CODE_ORIGIN=
CORREO_ARGENTINO_CREAR_ENVIO_ENDPOINT=
CORREO_ARGENTINO_ETIQUETA_ENDPOINT=

# --- PAQ.AR (Correo Argentino, alta de envíos y sucursales). Vacíos = no configurado ---
PAQAR_API_BASE_URL=
PAQAR_API_KEY=
PAQAR_AGREEMENT=
